{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "react"],
	"jsPlugins": [
		"./oxlint-rules/filenameConvention.ts",
		"./oxlint-rules/noRawStyleValues.ts",
		"./oxlint-rules/requireShiftSkipConfirm.ts",
		"./oxlint-rules/noHarnessBranches.ts"
	],
	"categories": {
		"correctness": "error",
		"style": "error"
	},
	"rules": {
		"local/filename-convention": "error",
		"no-unused-vars": [
			"error",
			{
				"argsIgnorePattern": "^_",
				"varsIgnorePattern": "^_",
				"caughtErrorsIgnorePattern": "^_"
			}
		],
		"typescript/consistent-type-definitions": ["error", "type"],
		"typescript/explicit-member-accessibility": [
			"error",
			{ "accessibility": "no-public" }
		],
		"unicorn/filename-case": "off",
		"no-magic-numbers": "off",
		"func-style": "off",
		"sort-imports": "off",
		"sort-keys": "off",
		"id-length": "off",
		"no-ternary": "off",
		"no-nested-ternary": "off",
		"unicorn/no-nested-ternary": "off",
		"unicorn/no-null": "off",
		"max-statements": "off",
		"max-params": "off",
		"max-depth": "off",
		"init-declarations": "off",
		"no-continue": "off",
		"prefer-named-capture-group": "off",
		"prefer-destructuring": "off",
		"no-implicit-coercion": "off",
		"no-duplicate-imports": "off",
		"unicorn/no-await-expression-member": "off",
		"typescript/method-signature-style": "off",
		"react/jsx-max-depth": "off",
		"react/jsx-handler-names": "off",
		"react/jsx-props-no-spreading": "off",
		"typescript/parameter-properties": "off",
		"capitalized-comments": "off",
		"unicorn/prefer-ternary": "off",
		"unicorn/prefer-spread": "off",
		"unicorn/prefer-default-parameters": "off",
		"unicorn/numeric-separators-style": "off",
		"unicorn/no-unreadable-array-destructuring": "off",
		"unicorn/number-literal-case": "off",
		"curly": "off",
		"unicorn/switch-case-braces": "off",
		"new-cap": "off"
	},
	"env": {
		"builtin": true
	},
	"overrides": [
		{
			"files": ["src/**/*.ts", "src/**/*.tsx"],
			"rules": {
				"harness/no-harness-branches": [
					"error",
					{
						"adapterDirs": ["src/shared/harnessAdapters"],
						"allow": {
							"src/commands/backlog/resolveHarness.ts": "parses the --harness flag value into a HarnessKind; not a behaviour branch",
							"src/shared/harnesses.ts": "the harness registry itself: each HarnessKind's command, home directory and sync destinations",
							"src/commands/review/reviewerHarnesses.ts": "names the two fixed structured-run reviewers and the words that identify each reviewer's output",
							"src/commands/review/reviewerSlots.ts": "maps each fixed reviewer to its output path from buildReviewPaths",
							"src/commands/sessions/web/harnessOffSwitch.ts": "maps each optional harness to its harness.expose*Actions config key",
							"src/commands/roam/postRoamActivity.ts": "keys are Roam activity app ids (claude-code, codex, pi), not harness kinds"
						}
					}
				]
			}
		},
		{
			"files": ["**/*.test.ts", "**/*.test.tsx", "**/*.d.ts", "src/index.ts"],
			"rules": {
				"local/filename-convention": "off",
				"harness/no-harness-branches": "off"
			}
		},
		{
			"files": [
				"src/commands/sessions/web/ui/**/*.ts",
				"src/commands/sessions/web/ui/**/*.tsx",
				"src/commands/backlog/web/ui/**/*.ts",
				"src/commands/backlog/web/ui/**/*.tsx"
			],
			"rules": {
				"design/no-raw-style-values": "error",
				"confirm/require-shift-skip-confirm": [
					"error",
					{
						"allow": {
							"CloneConfirmation.tsx": "opened by a failed launch, not a click",
							"ServerConflictDialog.tsx": "opened by a port conflict, not a click",
							"UnsavedChangesPrompt.tsx": "opened by navigating away, not a click",
							"CloseItemDialog.tsx": "trigger CloseStatusMenuItem holds the hook via useCloseItemFlow",
							"DismissConfirmDialog.tsx": "trigger DismissButton holds the hook",
							"MarkDoneConfirmDialog.tsx": "trigger CompleteButton holds the hook",
							"RestartConfirmDialog.tsx": "trigger ShiftSkipMenuItem holds the Shift-skip",
							"PeerRestartConfirmDialog.tsx": "trigger ShiftSkipMenuItem holds the Shift-skip",
							"UpdateAssistConfirmDialog.tsx": "trigger ShiftSkipMenuItem holds the Shift-skip",
							"ConfigArrayItemRemoveDialog.tsx": "trigger ConfigArrayItemActions holds the hook"
						}
					}
				]
			}
		},
		{
			"files": [
				"src/commands/sessions/web/ui/designSystem/**",
				"src/commands/sessions/web/ui/**/*.test.ts",
				"src/commands/sessions/web/ui/**/*.test.tsx",
				"src/commands/backlog/web/ui/**/*.test.ts",
				"src/commands/backlog/web/ui/**/*.test.tsx"
			],
			"rules": {
				"design/no-raw-style-values": "off"
			}
		}
	],
	"ignorePatterns": ["dist/**", "**/.venv/**"]
}
