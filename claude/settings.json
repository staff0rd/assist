{
	"autoMemoryEnabled": false,
	"feedbackDrafts": "off",
	"attribution": {
		"commit": "",
		"pr": ""
	},
	"env": {
		"CLAUDE_AFK_TIMEOUT_MS": "2147483647"
	},
	"statusLine": {
		"type": "command",
		"command": "assist status-line"
	},
	"hooks": {
		"PreToolUse": [
			{
				"matcher": "Bash",
				"hooks": [{ "type": "command", "command": "assist cli-hook" }]
			},
			{
				"matcher": "PowerShell",
				"hooks": [{ "type": "command", "command": "assist cli-hook" }]
			},
			{
				"matcher": "Read|Grep|Glob",
				"hooks": [{ "type": "command", "command": "assist cli-hook" }]
			},
			{
				"matcher": "Edit|Write|MultiEdit",
				"hooks": [{ "type": "command", "command": "assist edit-hook" }]
			}
		],
		"Notification": [
			{
				"matcher": "",
				"hooks": [{ "type": "command", "command": "assist notify" }]
			}
		],
		"SessionStart": [
			{
				"matcher": "",
				"hooks": [
					{ "type": "command", "command": "assist handover load" },
					{ "type": "command", "command": "assist advise --hook" }
				]
			}
		]
	},
	"permissions": {
		"allow": [
			"SlashCommand(/verify)",
			"SlashCommand(/commit)",
			"SlashCommand(/devlog)",
			"SlashCommand(/refactor)",
			"SlashCommand(/review-pr-comments)",
			"SlashCommand(/transcripts)",
			"Skill(verify)",
			"Skill(commit)",
			"Skill(devlog)",
			"Skill(refactor)",
			"Skill(review-pr-comments)",
			"Skill(transcripts)",
			"Skill(jira)",
			"SlashCommand(/jira)",
			"Skill(github)",
			"SlashCommand(/github)",
			"Skill(seq)",
			"SlashCommand(/seq)",
			"SlashCommand(/sql)",
			"Skill(inspect)",
			"SlashCommand(/inspect)",
			"Skill(prompts)",
			"SlashCommand(/prompts)",
			"Skill(screenshot)",
			"SlashCommand(/screenshot)",
			"Skill(draft)",
			"SlashCommand(/draft)",
			"Skill(next-backlog-item)",
			"SlashCommand(/next)",
			"Skill(test-cover)",
			"SlashCommand(/test-cover)",
			"Skill(test-review)",
			"SlashCommand(/test-review)",
			"Skill(handover)",
			"SlashCommand(/handover)",
			"Skill(recall)",
			"SlashCommand(/recall)",
			"Skill(strip-code-comments)",
			"SlashCommand(/strip-code-comments)",
			"Skill(subtask)",
			"SlashCommand(/subtask)",
			"Skill(miro)",
			"SlashCommand(/miro)",
			"Skill(slack-post)",
			"SlashCommand(/slack-post)",
			"Bash(git ls-files:*)",
			"Bash(gh pr checks:*)",
			"Bash(ls ~/.assist/pr-comments:*)",
			"Read(~/.assist/pr-comments/**)",
			"WebFetch(domain:staffordwilliams.com)"
		],
		"deny": ["SendFeedback"]
	}
}
