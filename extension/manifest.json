{
	"manifest_version": 3,
	"name": "assist",
	"version": "1.0.0",
	"description": "Brings assist to GitHub: edit acceptance criteria as an outline, and send a comment, PR, issue or Gmail message to assist to start a session. Checks out Azure DevOps PRs and addresses their comments. Sends feedback on a local docs preview.",
	"browser_specific_settings": {
		"gecko": {
			"id": "assist@staff0rd.github.io",
			"strict_min_version": "109.0",
			"update_url": "https://raw.githubusercontent.com/staff0rd/assist/main/extension/updates.json"
		}
	},
	"icons": {
		"16": "icons/assist-16.png",
		"32": "icons/assist-32.png",
		"128": "icons/assist-128.png"
	},
	"web_accessible_resources": [
		{
			"resources": ["icons/assist-32.png"],
			"matches": [
				"https://github.com/*",
				"https://dev.azure.com/*",
				"https://*.visualstudio.com/*",
				"https://mail.google.com/*",
				"http://localhost/*",
				"http://127.0.0.1/*"
			]
		}
	],
	"content_security_policy": {
		"extension_pages": "script-src 'self'"
	},
	"permissions": ["storage", "alarms"],
	"optional_permissions": ["userScripts"],
	"host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
	"options_ui": {
		"page": "options.html"
	},
	"background": {
		"scripts": ["background.js"]
	},
	"content_scripts": [
		{
			"matches": [
				"https://github.com/*",
				"https://dev.azure.com/*",
				"https://*.visualstudio.com/*",
				"https://mail.google.com/*"
			],
			"js": ["content.js"],
			"run_at": "document_idle"
		},
		{
			"matches": ["http://localhost/*", "http://127.0.0.1/*"],
			"js": ["docs.js"],
			"run_at": "document_idle"
		}
	]
}
