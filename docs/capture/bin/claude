#!/usr/bin/env node
// Stand-in for the claude CLI during docs capture, so no real harness runs in
// the isolated HOME. It renders a scripted transcript for the session's prompt
// (from $HOME/.fake-claude.json, written by the capture's session steps) and
// answers `claude -p` title requests from the same script. A script's `edits`
// are written into the session's working copy so its git counts show.
(async () => {
	const { existsSync, mkdirSync, readFileSync, writeFileSync } = await import(
		"node:fs"
	);
	const { dirname, join } = await import("node:path");

	const scriptsFile = join(process.env.HOME ?? "", ".fake-claude.json");
	const scripts = existsSync(scriptsFile)
		? JSON.parse(readFileSync(scriptsFile, "utf8"))
		: {};
	const args = process.argv.slice(2);
	const prompt = args.at(-1)?.startsWith("-") ? undefined : args.at(-1);

	if (args.includes("--input-format")) {
		await runSdk(args, scripts);
		return;
	}

	if (args.includes("-p")) {
		const task = prompt?.split("Task: ").at(-1)?.trim() ?? "";
		const script = scripts[task];
		console.log(script?.title ?? task.split(/\s+/).slice(0, 4).join(" "));
		return;
	}

	for (const [path, content] of Object.entries(
		(prompt && scripts[prompt]?.edits) ?? {},
	)) {
		mkdirSync(dirname(path), { recursive: true });
		writeFileSync(path, content);
	}

	const width = Math.min(process.stdout.columns || 100, 100);
	const accent = (text) => `\x1b[38;5;174m${text}\x1b[0m`;
	const box = (lines) => [
		accent(`╭${"─".repeat(width - 2)}╮`),
		...lines.map((line) => `${accent("│")} ${line.padEnd(width - 4)} ${accent("│")}`),
		accent(`╰${"─".repeat(width - 2)}╯`),
	];
	const reply = (prompt && scripts[prompt]?.reply) ?? [];
	const out = [
		...box(["✻ Welcome to Claude Code!", ""]),
		"",
		...(prompt ? [`\x1b[2m>\x1b[0m ${prompt}`] : []),
		...reply.flatMap((line) =>
			line.startsWith("⎿")
				? [`  \x1b[2m${line}\x1b[0m`]
				: ["", `${accent("●")} ${line}`],
		),
		"",
		...box([">"]),
		"\x1b[2m  ? for shortcuts\x1b[0m",
	];
	process.stdout.write(`${out.join("\r\n")}\r\n`);
	setInterval(() => {}, 60_000);
})();

// Agent SDK mode: speaks the stream-json protocol the SDK drives a headless
// claude with, answering each user message from the scripted reply and writing
// the conversation's JSONL transcript as the real CLI does.
async function runSdk(args, scripts) {
	const { appendFileSync, mkdirSync } = await import("node:fs");
	const { randomUUID } = await import("node:crypto");
	const { join } = await import("node:path");
	const { createInterface } = await import("node:readline");
	const argValue = (args, name) => {
		const joined = args.find((arg) => arg.startsWith(`${name}=`));
		if (joined) return joined.slice(name.length + 1);
		const index = args.indexOf(name);
		return index === -1 ? undefined : args[index + 1];
	};

	const textOf = (content) =>
		typeof content === "string"
			? content
			: (content ?? [])
					.filter((block) => block.type === "text")
					.map((block) => block.text)
					.join("\n");

	const sessionId =
		argValue(args, "--session-id") ?? argValue(args, "--resume") ?? randomUUID();
	const cwd = process.cwd();
	const dir = join(
		process.env.HOME ?? "",
		".claude",
		"projects",
		cwd.replace(/[^a-zA-Z0-9]/g, "-"),
	);
	mkdirSync(dir, { recursive: true });
	const file = join(dir, `${sessionId}.jsonl`);
	const model = "claude-sonnet-4-5";
	let parentUuid = null;

	const emit = (message) => process.stdout.write(`${JSON.stringify(message)}\n`);
	const record = (type, message) => {
		const uuid = randomUUID();
		appendFileSync(
			file,
			`${JSON.stringify({
				parentUuid,
				isSidechain: false,
				userType: "external",
				cwd,
				sessionId,
				version: "2.0.0",
				gitBranch: "main",
				type,
				message,
				uuid,
				timestamp: new Date().toISOString(),
			})}\n`,
		);
		parentUuid = uuid;
		return uuid;
	};
	const respond = (request, response) =>
		emit({
			type: "control_response",
			response: {
				subtype: "success",
				request_id: request.request_id,
				response,
			},
		});
	const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));

	let turns = Promise.resolve();
	const answer = async (prompt) => {
		const script = scripts[prompt] ?? {};
		record("user", { role: "user", content: prompt });
		const reply = script.reply ?? [];
		for (const [index, text] of reply.entries()) {
			await sleep(200);
			const last = index === reply.length - 1;
			const message = {
				id: `msg_${randomUUID()}`,
				type: "message",
				role: "assistant",
				model,
				content: [{ type: "text", text }],
				stop_reason: last && !script.hold ? "end_turn" : null,
				usage: { input_tokens: 2000, output_tokens: 100 },
			};
			const uuid = record("assistant", message);
			emit({
				type: "assistant",
				message,
				parent_tool_use_id: null,
				session_id: sessionId,
				uuid,
			});
		}
		if (script.hold) return;
		emit({
			type: "result",
			subtype: "success",
			is_error: false,
			duration_ms: 1000,
			duration_api_ms: 1000,
			num_turns: 1,
			result: (script.reply ?? []).at(-1) ?? "",
			session_id: sessionId,
			total_cost_usd: 0,
			usage: { input_tokens: 2000, output_tokens: 100 },
			modelUsage: {},
			permission_denials: [],
			uuid: randomUUID(),
		});
		if (script.suggestion)
			emit({
				type: "prompt_suggestion",
				suggestion: script.suggestion,
				session_id: sessionId,
				uuid: randomUUID(),
			});
	};

	createInterface({ input: process.stdin }).on("line", (line) => {
		if (!line.trim()) return;
		const message = JSON.parse(line);
		if (message.type === "control_request") {
			if (message.request.subtype === "initialize") {
				respond(message, {
					commands: [],
					agents: [],
					output_style: "default",
					available_output_styles: ["default"],
					models: [],
					account: {},
				});
				emit({
					type: "system",
					subtype: "init",
					cwd,
					session_id: sessionId,
					tools: [],
					mcp_servers: [],
					model,
					permissionMode: "auto",
					slash_commands: [],
					apiKeySource: "none",
					output_style: "default",
					uuid: randomUUID(),
				});
			} else respond(message, {});
			return;
		}
		if (message.type === "user") {
			const prompt = textOf(message.message?.content);
			turns = turns.then(() => answer(prompt));
		}
	});
	process.stdin.on("end", () => turns.then(() => process.exit(0)));
}
